rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===== HELPER FUNCTIONS =====

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function authEmail() {
      return request.auth.token.email;
    }

    function ownsUidDoc(userId) {
      return signedIn() && userId == uid();
    }

    function resourceHasOwnerUid() {
      return signedIn() && resource.data.uid == uid();
    }

    function incomingHasOwnerUid() {
      return signedIn() && request.resource.data.uid == uid();
    }

    function resourceHasOwnerEmail() {
      return signedIn() && authEmail() != null && resource.data.email == authEmail();
    }

    function incomingHasOwnerEmail() {
      return signedIn() && authEmail() != null && request.resource.data.email == authEmail();
    }

    // Sirf wahi admin likh sakta hai jiska ye pharmacy/admin doc hai
    function adminOwns(adminId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(adminId)) &&
        get(/databases/$(database)/documents/admins/$(adminId)).data.uid == uid();
    }

    function orderOwner() {
      return signedIn() && (
        resource.data.uid == uid() ||
        resource.data.userId == uid() ||
        resource.data.customerUid == uid() ||
        resource.data.riderUid == uid() ||
        resource.data.adminUid == uid() ||
        resource.data.assignedRiderUid == uid()
      );
    }

    function incomingOrderOwner() {
      return signedIn() && (
        request.resource.data.uid == uid() ||
        request.resource.data.userId == uid() ||
        request.resource.data.customerUid == uid() ||
        request.resource.data.riderUid == uid() ||
        request.resource.data.adminUid == uid() ||
        request.resource.data.assignedRiderUid == uid()
      );
    }

    function adminRelatedIncoming() {
      return signedIn() && (
        request.resource.data.adminUid == uid() ||
        request.resource.data.pharmacyUid == uid() ||
        request.resource.data.assignedAdminUid == uid()
      );
    }

    // ===== USERS =====
    match /users/{userId} {
      allow read, update: if ownsUidDoc(userId);
      allow create: if ownsUidDoc(userId) && incomingHasOwnerUid();
      allow delete: if false;
    }

    // ===== ADMINS =====
    match /admins/{adminId} {
      allow read: if signedIn();
      allow create: if incomingHasOwnerUid() && incomingHasOwnerEmail();
      // FIX: Sirf apna doc update kar sakta hai (pehle koi bhi signedIn update kar sakta tha)
      allow update: if adminOwns(adminId);
      allow delete: if false;

      // Admin ke medicines subcollection
      match /medicines/{medicineId} {
        allow read: if true;
        allow write: if adminOwns(adminId);
      }
    }

    // ===== RIDERS =====
    match /riders/{riderId} {
      allow read: if signedIn();
      allow create: if incomingHasOwnerUid() && incomingHasOwnerEmail();
      allow update: if signedIn();
      allow delete: if false;
    }

    // ===== ORDERS =====
    match /orders/{orderId} {
      allow create: if signedIn();
      allow read: if signedIn();
      allow update: if signedIn();
      allow delete: if false;
    }

    // ===== ROOT MEDICINES (legacy - sirf read) =====
    match /medicines/{medicineId} {
      allow read: if true;
      allow write: if false;
    }

    // ===== PHARMACIES =====
    match /pharmacies/{pharmacyId} {
      allow read: if true;
      // FIX: Sirf us pharmacy ka admin hi pharmacy doc update kar sakta hai
      allow create: if signedIn();
      allow update: if adminOwns(pharmacyId);
      allow delete: if false;

      // FIX: Medicines sirf pharmacy ka admin add/edit/delete kar sakta hai
      // (pehle koi bhi signedIn user kar sakta tha)
      match /medicines/{medicineId} {
        allow read: if true;
        allow write: if adminOwns(pharmacyId);
      }

      // FIX: Categories bhi sirf admin control karega
      match /customCategories/{categoryId} {
        allow read: if true;
        allow write: if adminOwns(pharmacyId);
      }
    }

    // ===== ROOT CUSTOM CATEGORIES (legacy - sirf read) =====
    match /customCategories/{categoryId} {
      allow read: if true;
      allow write: if false;
    }

    // ===== PHARMACY PROFILES =====
    match /pharmacyProfiles/{profileId} {
      allow read: if true;
      allow create, update: if signedIn();
      allow delete: if false;
    }

    // ===== WISHLISTS =====
    match /wishlists/{userId} {
      allow read, write: if ownsUidDoc(userId);
    }

    // ===== CARTS =====
    match /carts/{cartId} {
      allow read, write: if ownsUidDoc(cartId);
    }

    // ===== USER ADDRESSES =====
    match /userAddresses/{userId} {
      allow read, write: if ownsUidDoc(userId);
    }

    // ===== RIDER REQUESTS =====
    match /riderRequests/{requestId} {
      allow create: if signedIn();
      allow read: if signedIn();
      allow update: if signedIn() && (
        resource.data.riderUid == uid() ||
        resource.data.adminUid == uid() ||
        resource.data.pharmacyUid == uid() ||
        resource.data.assignedAdminUid == uid()
      );
      allow delete: if signedIn() && (
        resource.data.adminUid == uid() ||
        resource.data.pharmacyUid == uid() ||
        resource.data.assignedAdminUid == uid()
      );
    }

    // ===== PRESCRIPTIONS =====
    match /prescriptions/{prescriptionId} {
      allow create: if incomingHasOwnerUid();
      allow read, update: if resourceHasOwnerUid();
      allow delete: if false;
    }

    // ===== RIDER WITHDRAWALS =====
    match /riderWithdrawals/{withdrawalId} {
      allow create: if incomingHasOwnerUid();
      allow read, update: if resourceHasOwnerUid();
      allow delete: if false;
    }

    // ===== WITHDRAWAL REQUESTS =====
    match /withdrawalRequests/{requestId} {
      allow create: if incomingHasOwnerUid() || adminRelatedIncoming();
      allow read, update: if resourceHasOwnerUid() || adminRelatedIncoming();
      allow delete: if false;
    }

    // ===== ADMIN PAYOUTS =====
    match /adminPayouts/{payoutId} {
      allow create: if adminRelatedIncoming();
      allow read, update: if signedIn() && (
        resource.data.adminUid == uid() ||
        resource.data.pharmacyUid == uid()
      );
      allow delete: if false;
    }

    // ===== SUPPORT TICKETS =====
    match /supportTickets/{ticketId} {
      allow create: if incomingHasOwnerUid();
      allow read, update: if resourceHasOwnerUid() || adminRelatedIncoming();
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.uid == uid();
        allow update, delete: if false;
      }
    }

    // ===== DEFAULT: Baaki sab block =====
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
