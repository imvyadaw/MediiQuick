rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isAuthed() && request.auth.uid == uid;
    }

    function hasFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ══════════════════════════════════════════════════════════════
    // USERS
    // ══════════════════════════════════════════════════════════════
    match /users/{userId} {
      allow read: if true;
      allow create: if hasFields(['name', 'email', 'mobile', 'passwordHash'])
                    && request.resource.data.createdAt is number;
      allow update: if isOwner(userId) || isAuthed();
      allow delete: if isOwner(userId);
    }

    // ══════════════════════════════════════════════════════════════
    // ADMINS
    // ══════════════════════════════════════════════════════════════
    match /admins/{adminId} {
      allow read: if true;
      allow create: if isAuthed() && hasFields(['email', 'shopName', 'adminName']);
      allow update: if isAuthed();
      allow delete: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════════
    // RIDERS
    // ══════════════════════════════════════════════════════════════
    match /riders/{riderId} {
      allow read: if true;
      allow create: if isAuthed() && hasFields(['name', 'phone', 'passwordHash']);
      allow update: if isAuthed();
      allow delete: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════════
    // ORDERS — FIX: Authenticated user apne orders padh sake
    // userId ya customerEmail se where() query allow honi chahiye
    // ══════════════════════════════════════════════════════════════
    match /orders/{orderId} {
      // ✅ FIX: Authenticated user sirf apne orders read kar sake
      // resource.data.userId == request.auth.uid → apna order
      // list queries ke liye: isAuthed() enough hai (where filter JS side pe bhi hai)
      allow read: if isAuthed();

      allow create: if isAuthed()
                    && hasFields(['customerId', 'items', 'totalAmount', 'placedAt', 'status'])
                    // ✅ FIX: profile.html 'total' field use karta hai, 'totalAmount' nahi
                    // Dono field names allow karo
                    || (isAuthed() && hasFields(['orderId', 'items', 'total', 'placedAt', 'status']));

      allow update: if isAuthed();
      allow delete: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════════
    // MEDICINES
    // ══════════════════════════════════════════════════════════════
    match /medicines/{medicineId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════════
    // PHARMACIES
    // ══════════════════════════════════════════════════════════════
    match /pharmacies/{pharmacyId} {
      allow read: if true;
      allow write: if isAuthed();

      match /medicines/{medicineId} {
        allow read: if true;
        allow write: if isAuthed();
      }

      match /customCategories/{categoryId} {
        allow read: if true;
        allow write: if isAuthed();
      }
    }

    // ══════════════════════════════════════════════════════════════
    // CUSTOM CATEGORIES
    // ══════════════════════════════════════════════════════════════
    match /customCategories/{categoryId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════════
    // PHARMACY PROFILES
    // ══════════════════════════════════════════════════════════════
    match /pharmacyProfiles/{profileId} {
      allow read: if true;
      allow write: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════════
    // WISHLISTS
    // ══════════════════════════════════════════════════════════════
    match /wishlists/{userId} {
      allow read, write: if isOwner(userId);
    }

    // ══════════════════════════════════════════════════════════════
    // CARTS
    // ══════════════════════════════════════════════════════════════
    match /carts/{cartId} {
      allow read, write: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════════
    // USER ADDRESSES
    // ══════════════════════════════════════════════════════════════
    match /userAddresses/{userId} {
      allow read, write: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════════
    // RIDER REQUESTS
    // ══════════════════════════════════════════════════════════════
    match /riderRequests/{requestId} {
      allow read, write: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════════
    // PRESCRIPTIONS
    // ══════════════════════════════════════════════════════════════
    match /prescriptions/{prescriptionId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && hasFields(['uid', 'customerName', 'createdAt']);
      allow update, delete: if isAuthed();
    }

    // ══════════════════════════════════════════════════════════════
    // RIDER WITHDRAWALS
    // ══════════════════════════════════════════════════════════════
    match /riderWithdrawals/{withdrawalId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && hasFields(['riderId', 'amount', 'requestedAt', 'status']);
      allow update: if isAuthed();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // WITHDRAWAL REQUESTS
    // ══════════════════════════════════════════════════════════════
    match /withdrawalRequests/{requestId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && hasFields(['adminId', 'amount', 'requestedAt', 'status']);
      allow update: if isAuthed();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // ADMIN PAYOUTS
    // ══════════════════════════════════════════════════════════════
    match /adminPayouts/{payoutId} {
      allow read: if isAuthed();
      allow create: if isAuthed() && hasFields(['adminId', 'amount', 'paidAt']);
      allow update: if isAuthed();
      allow delete: if false;
    }

    // ══════════════════════════════════════════════════════════════
    // SUPPORT TICKETS
    // ══════════════════════════════════════════════════════════════
    match /supportTickets/{ticketId} {
      allow read: if true;
      allow create: if hasFields(['ticketId', 'status', 'createdAt'])
                    && request.resource.data.status == 'open'
                    && request.resource.data.resolved == false
                    && request.resource.data.keys().hasAny(['message'])
                       ? request.resource.data.message.size() < 2000
                       : true;
      allow update, delete: if isAuthed();

      match /messages/{messageId} {
        allow read: if true;
        allow create: if hasFields(['text', 'senderType', 'timestamp'])
                      && request.resource.data.text.size() < 2000;
        allow update, delete: if isAuthed();
      }
    }

  }
}
